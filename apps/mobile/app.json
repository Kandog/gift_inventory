{
  "expo": {
    "name": "Gift Inventory",
    "slug": "gift-inventory",
    "scheme": "giftinventory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.giftinventory",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Gift Inventory syncs with your team's server on the office Wi-Fi."
      }
    },
    "android": {
      "package": "com.example.giftinventory",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Gift Inventory uses the camera to scan Gift Labels, barcodes and pairing codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
